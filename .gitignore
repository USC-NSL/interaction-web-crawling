# Allowlist: ignore everything, then re-include only what is shared.
# Git can only re-include a file if its parent directory is re-included,
# which is why each directory is un-ignored and then its contents re-ignored.

/*
!/.gitignore
!/README.md

# ---- Corpus: pages, plus what is needed to serve and test them ----
!/interaction-corpus/
/interaction-corpus/*
!/interaction-corpus/pages/
!/interaction-corpus/sentinel/
!/interaction-corpus/manifest.json
!/interaction-corpus/README.md
# tools/ and schema/ whole: acceptance.py, mutations.py, gen_sentinels.py and the
# schema define what the corpus pages are tested against, and must move with them.
!/interaction-corpus/tools/
!/interaction-corpus/schema/

# ---- Explorer, plus the screener modules it imports ----
# tools/ is re-included whole, not file by file. A per-file allowlist silently drops
# every module added afterwards, which is how blocking.py - imported by explore.py -
# was left out of the first commit and made the tree unrunnable.
!/page-screener/
/page-screener/*
!/page-screener/requirements.txt
!/page-screener/README.md
!/page-screener/tools/

# ---- Crawl evaluation: tools only; runs/ (WARCs, logs, bundles) stays local ----
!/crawl-eval/
/crawl-eval/*
!/crawl-eval/README.md
!/crawl-eval/requirements.txt
!/crawl-eval/tools/

# ---- Never commit, even inside allowed directories ----
__pycache__/
*.pyc
.DS_Store
**/logs/
**/out/
# Caches, including Brave's filter lists that tools/sync_brave_lists.py copies out of
# a crawl profile: ~9 MB of third-party lists, recreatable from any crawl profile, and
# whose component ids, versions and SHA-256s are recorded in every explorer result.
/page-screener/cache/
/page-screener/cache/brave-lists/
